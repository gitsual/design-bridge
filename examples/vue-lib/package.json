{
  "name": "@design-bridge/example-vue",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable example: a Vue 3 component library wired to design-bridge.",
  "type": "module",
  "scripts": {
    "generate": "design-bridge-generate --registry registry.json --out src/stories/generated",
    "storybook": "npm run generate && storybook dev -p 6006",
    "build-storybook": "npm run generate && storybook build"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@design-bridge/generator": "file:../../packages/generator",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/vue3-vite": "^8.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
