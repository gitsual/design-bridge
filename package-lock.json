{
  "name": "design-bridge",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "design-bridge",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@design-bridge/figma-plugin": {
      "resolved": "packages/figma-plugin",
      "link": true
    },
    "node_modules/@design-bridge/generator": {
      "resolved": "packages/generator",
      "link": true
    },
    "node_modules/@design-bridge/registry": {
      "resolved": "packages/registry",
      "link": true
    },
    "node_modules/@design-bridge/tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "packages/figma-plugin": {
      "name": "@design-bridge/figma-plugin",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/generator": {
      "name": "@design-bridge/generator",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@design-bridge/registry": "0.1.0"
      },
      "bin": {
        "design-bridge-generate": "src/cli.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/registry": {
      "name": "@design-bridge/registry",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/tokens": {
      "name": "@design-bridge/tokens",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "design-bridge-tokens": "src/cli.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
